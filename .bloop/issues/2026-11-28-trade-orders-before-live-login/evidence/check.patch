+    fn add_order() -> QfexTradeRequest {
+        QfexTradeRequest::AddOrder(crate::websocket::messages::QfexAddOrder {
+            symbol: aapl(),
+            side: crate::common::enums::QfexSide::Buy,
+            order_type: crate::common::enums::QfexOrderType::Limit,
+            order_time_in_force: crate::common::enums::QfexTimeInForce::Gtc,
+            quantity: rust_decimal::Decimal::ONE,
+            price: Some(rust_decimal::Decimal::new(20001, 2)),
+            client_order_id: "O-1".to_string(),
+            reduce_only: false,
+        })
+    }
+
+    #[tokio::test]
+    async fn trade_order_sent_during_a_reconnect_reaches_the_next_socket_only_after_its_auth() {
+        let (venue, url) = MockVenue::start().await;
+        let mut client = QfexWebSocketClient::new_trade(&url, fixed_signer(), false).unwrap();
+        let mut rx = client.connect().await.unwrap();
+        assert!(matches!(next(&mut rx).await, QfexWsMessage::Authenticated));
+        wait_until("the first session", || venue.requests(1).len() == 2).await;
+        let socket = client.client.clone().unwrap();
+
+        let next_upgrade_held = venue.next_upgrade_gate.lock().await;
+        let read_loop_held_at_reconnect = client.session.gate.state.lock().await;
+        venue.drop_connection.notify_one();
+        wait_until("the reconnect", || !socket.is_active()).await;
+
+        let order = add_order();
+        let (sent, ()) = tokio::join!(client.send(&order), async {
+            drop(next_upgrade_held);
+            wait_until("the next socket", || {
+                venue.connections.load(Ordering::SeqCst) == 2 && socket.is_active()
+            })
+            .await;
+            tokio::time::sleep(Duration::from_millis(300)).await;
+            drop(read_loop_held_at_reconnect);
+        });
+        sent.unwrap();
+
+        wait_until("the second session", || venue.requests(2).len() >= 3).await;
+        tokio::time::sleep(Duration::from_millis(200)).await;
+        let kinds: Vec<Value> = venue
+            .requests(2)
+            .iter()
+            .map(|frame| frame["type"].clone())
+            .collect();
+        assert_eq!(
+            kinds,
+            [json!("auth"), json!("subscribe"), json!("add_order")],
+            "the order reaches the next socket only after that socket's own auth"
+        );
+        assert_eq!(
+            venue.requests(1).len(),
+            2,
+            "the order did not go out on the first socket"
+        );
+        client.disconnect().await;
+    }
+
+    #[tokio::test]
+    async fn trade_late_auth_answer_is_not_a_login_of_the_next_socket() {
+        let (venue, url) = MockVenue::start().await;
+        venue
+            .defer_first_auth_then_drop
+            .store(true, Ordering::SeqCst);
+        let states = Arc::new(parking_lot::Mutex::new(Vec::new()));
+        let seen = states.clone();
+        let mut client = QfexWebSocketClient::new_trade(&url, fixed_signer(), false)
+            .unwrap()
+            .with_state_sink(SocketStateSink::new(move |state| seen.lock().push(state)));
+        let mut rx = client.connect().await.unwrap();
+        wait_until("the first auth", || venue.requests(1).len() == 1).await;
+
+        let read_loop_held_at_subscribe_gate = client.session.gate.state.lock().await;
+        venue.release_acks.notify_one();
+        wait_until("the next socket", || {
+            venue.connections.load(Ordering::SeqCst) == 2 && states.lock().len() == 3
+        })
+        .await;
+        drop(read_loop_held_at_subscribe_gate);
+
+        let mut before_reconnect = Vec::new();
+        loop {
+            match next(&mut rx).await {
+                QfexWsMessage::Reconnected => break,
+                message => before_reconnect.push(message),
+            }
+        }
+        assert!(
+            !before_reconnect
+                .iter()
+                .any(|message| matches!(message, QfexWsMessage::Authenticated)),
+            "the answer of a closed connection reached the stream as a login: {before_reconnect:?}"
+        );
+        assert!(matches!(next(&mut rx).await, QfexWsMessage::Authenticated));
+        client.disconnect().await;
+    }
+
