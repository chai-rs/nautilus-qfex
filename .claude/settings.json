{
  "_comment": "Written by bloop guardrails (req 12). This runs on the machine of everyone who clones this repo; it must never fetch anything from the network.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          { "type": "command", "command": "./.claude/hooks/protect-paths.sh", "timeout": 10 }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          { "type": "command", "command": "./.claude/hooks/inject-rules.sh", "timeout": 10 }
        ]
      }
    ]
  }
}
